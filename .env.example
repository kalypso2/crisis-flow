# ─────────────────────────────────────────────────────────────────────────────
# CrisisFlow — environment variable template
# Copy this file to .env and fill in your real values.
# .env is gitignored; this file is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini ───────────────────────────────────────────────────────────
# Get keys at: https://aistudio.google.com/app/apikey (one per Google Cloud project)
#
# Rotation (gemini_manager.py): comma-separated, no spaces around commas unless
# each key is quoted (prefer no spaces). First key is used after load_dotenv;
# each .call() advances round-robin; 429 retries the next key.
#   GEMINI_KEYS=AIzaSy_first_project,AIzaSy_second_project,AIzaSy_third
#
# Single-key fallback: if GEMINI_KEYS is unset/empty, manager uses GOOGLE_API_KEY.
# timestamp_agent.py (google-genai) still reads GOOGLE_API_KEY unless you wire it
# to the manager — set both to the same first key, or duplicate all keys in
# GEMINI_KEYS and keep GOOGLE_API_KEY as your primary for legacy code paths.
GEMINI_KEYS=AIzaSy_key_from_project_1,AIzaSy_key_from_project_2
GOOGLE_API_KEY=your_google_api_key_here

# ── ACLED Armed Conflict Data ─────────────────────────────────────────────────
# Required by: adapters.py (ACLEDAdapter) — live conflict event polling
# Free registration at: https://acleddata.com/register
ACLED_API_KEY=your_acled_api_key_here
ACLED_EMAIL=your_acled_email_here

# ── Twitter / X Filtered Stream ───────────────────────────────────────────────
# Required by: adapters.py (TwitterAdapter) — real-time conflict signal stream
# Requires a Twitter Developer account: https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ── Snowflake ─────────────────────────────────────────────────────────────────
# Required by: snowflake_store.py — persistent event storage
# Sign up at: https://signup.snowflake.com
SNOWFLAKE_ACCOUNT=your_account_identifier_here
SNOWFLAKE_USER=your_snowflake_username_here
SNOWFLAKE_PASSWORD=your_snowflake_password_here
SNOWFLAKE_DATABASE=CRISISFLOW
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
