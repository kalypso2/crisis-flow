# ─────────────────────────────────────────────────────────────────────────────
# CrisisFlow — environment variable template
# Copy this file to .env and fill in your real values.
# .env is gitignored; this file is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini / Search Grounding ─────────────────────────────────────────
# Required by: timestamp_agent.py
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── ACLED Armed Conflict Data ─────────────────────────────────────────────────
# Required by: adapters.py (ACLEDAdapter) — live conflict event polling
# Free registration at: https://acleddata.com/register
ACLED_API_KEY=your_acled_api_key_here
ACLED_EMAIL=your_acled_email_here

# ── Twitter / X Filtered Stream ───────────────────────────────────────────────
# Required by: adapters.py (TwitterAdapter) — real-time conflict signal stream
# Requires a Twitter Developer account: https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
